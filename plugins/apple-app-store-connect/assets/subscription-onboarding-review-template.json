{
  "accessPreflight": {
    "requiredBeforeAutomation": true,
    "onFailure": "promptForReauthorization",
    "appStoreConnect": {
      "required": true,
      "probe": "GET /v1/apps?limit=1"
    },
    "revenueCat": {
      "requiredForSubscriptions": true,
      "mcpServer": "RevenueCat",
      "probeTool": "mcp__RevenueCat.list_projects",
      "probeArguments": {
        "limit": 1
      },
      "stopOnStatuses": [
        "revoked_or_unauthorized",
        "insufficient_scope",
        "external_probe_required"
      ]
    }
  },
  "revenueCatIntegration": {
    "enabled": true,
    "projectId": "revenuecat-project-id",
    "projectName": "Example App",
    "entitlementIdentifier": "pro",
    "offeringIdentifier": "default",
    "packages": [
      "$rc_weekly",
      "$rc_monthly",
      "$rc_annual"
    ],
    "requiresAuthenticatedMcp": true,
    "productsMirrorAppStoreConnectSubscriptions": true
  },
  "pricingAvailability": {
    "downloadPrice": "0.00",
    "baseTerritory": "USA",
    "availability": "allCountries",
    "availableInNewTerritories": true
  },
  "pricingResearch": {
    "lastReviewedOn": "2026-06-01",
    "reviewIntervalMonths": 6,
    "nextReviewDue": "2026-12-01",
    "requiresCurrentResearch": true,
    "sources": [
      "https://www.revenuecat.com/state-of-subscription-apps-2025/",
      "https://www.revenuecat.com/blog/growth/subscription-app-trends-benchmarks-2026/",
      "https://developer.apple.com/app-store/subscriptions/",
      "https://developer.apple.com/help/app-store-connect/manage-subscriptions/manage-pricing-for-auto-renewable-subscriptions/"
    ],
    "benchmarkAnchors": [
      {
        "period": "ONE_WEEK",
        "role": "shortTermEntry",
        "benchmarkCustomerPrice": "4.99",
        "notes": "Weekly is part of the default launch pattern as a short-term entry plan; builders can remove it with a custom cadence reason when it does not fit the app."
      },
      {
        "period": "ONE_MONTH",
        "role": "primaryComparison",
        "benchmarkCustomerPrice": "9.99",
        "notes": "Monthly anchors the normal Pro value on the paywall."
      },
      {
        "period": "ONE_YEAR",
        "role": "bestValueRetention",
        "benchmarkCustomerPrice": "29.99",
        "notes": "Yearly is the best-value option and should show total annual billing clearly."
      }
    ],
    "refreshInstruction": "Refresh RevenueCat benchmark research and Apple subscription/pricing guidance every six months before locking prices."
  },
  "freeProAccessModel": {
    "default": true,
    "enabled": true,
    "creatorCanOverride": true,
    "targetFreeAccessPercent": 75,
    "targetProAccessPercent": 25,
    "customAccessSplitReason": "",
    "freeTier": {
      "name": "Free",
      "positioning": "Users get a real 70-80% taste of the app before paying.",
      "features": [
        "Choose favorite teams, topics, groups, tournaments, or goals",
        "View the personalized hub, schedule, countdown, results, or status",
        "Track a sensible number of favorites or reminders",
        "Use basic search, filters, and detail screens",
        "Keep using the core app without subscribing"
      ],
      "limits": [
        "Limited favorites, tracked items, or active reminders",
        "Limited advanced alerts, widgets, live activities, archives, exports, and deep analytics"
      ]
    },
    "proTier": {
      "name": "Pro",
      "positioning": "Power-user depth for people who want more than the core experience.",
      "features": [
        "Unlimited favorites, tracked items, alerts, or reminders",
        "Advanced notification controls and time-sensitive reminders",
        "Widgets, live activities, lock-screen experiences, or premium glanceables",
        "Historical archives, advanced stats, exports, comparisons, or deeper insights",
        "Premium personalization, themes, or ad-free experience when relevant"
      ],
      "lockedFeatureTypes": [
        "unlimited tracking",
        "advanced alerts",
        "widgets and live activities",
        "advanced history and analytics",
        "premium personalization"
      ],
      "locksCoreLoop": false
    },
    "paywall": {
      "timing": "afterFirstPersonalizedValue",
      "triggers": [
        "user reaches a generous free tracking or reminder limit",
        "user taps a clearly labeled Pro alert, widget, history, or analytics feature",
        "user shows intent by personalizing favorites or checking repeated detail views"
      ],
      "principles": [
        "never block first-run personalization",
        "show useful personalized content before the paywall",
        "keep restore purchases, terms, privacy, trial, renewal, and cancellation context visible"
      ]
    }
  },
  "subscriptionPricing": {
    "appDownloadModel": "freeWithSubscription",
    "baseTerritory": "USA",
    "useSingleSubscriptionGroup": true,
    "introOfferRecommended": true,
    "trialDefaults": {
      "enabledByDefault": true,
      "creatorCanOverride": true,
      "duration": "TWO_WEEKS",
      "displayDuration": "14-day",
      "offerMode": "FREE_TRIAL",
      "numberOfPeriods": 1,
      "primaryCta": "Start 14-day free trial",
      "postCtaTagline": "\u2713 No payment due now",
      "showTaglineOnlyWhenProductHasTrial": true,
      "customIntroOfferReason": ""
    },
    "defaultCadences": [
      "ONE_WEEK",
      "ONE_MONTH",
      "ONE_YEAR"
    ],
    "creatorCanOverrideCadences": true,
    "weeklyUseCase": "event-driven or short-horizon premium intent",
    "customCadenceReason": "",
    "customPriceReason": "",
    "customIntroOfferReason": "",
    "cadenceStrategy": {
      "weekly": "default short-term entry plan",
      "monthly": "primary comparison plan",
      "yearly": "best-value retention plan"
    },
    "products": [
      {
        "subscriptionId": "weekly-subscription-id",
        "productId": "com.example.app.pro.weekly",
        "period": "ONE_WEEK",
        "role": "shortTerm",
        "territory": "USA",
        "benchmarkCustomerPrice": "4.99",
        "pricePointId": "subscription-price-point-id",
        "preserveCurrentPrice": false
      },
      {
        "subscriptionId": "monthly-subscription-id",
        "productId": "com.example.app.pro.monthly",
        "period": "ONE_MONTH",
        "role": "primary",
        "territory": "USA",
        "benchmarkCustomerPrice": "9.99",
        "pricePointId": "subscription-price-point-id",
        "preserveCurrentPrice": false
      },
      {
        "subscriptionId": "yearly-subscription-id",
        "productId": "com.example.app.pro.yearly",
        "period": "ONE_YEAR",
        "role": "bestValue",
        "territory": "USA",
        "benchmarkCustomerPrice": "29.99",
        "pricePointId": "subscription-price-point-id",
        "preserveCurrentPrice": false
      }
    ],
    "introductoryOffers": [
      {
        "subscriptionId": "weekly-subscription-id",
        "territory": "USA",
        "offerMode": "FREE_TRIAL",
        "duration": "TWO_WEEKS",
        "numberOfPeriods": 1
      },
      {
        "subscriptionId": "monthly-subscription-id",
        "territory": "USA",
        "offerMode": "FREE_TRIAL",
        "duration": "TWO_WEEKS",
        "numberOfPeriods": 1
      },
      {
        "subscriptionId": "yearly-subscription-id",
        "territory": "USA",
        "offerMode": "FREE_TRIAL",
        "duration": "TWO_WEEKS",
        "numberOfPeriods": 1
      }
    ]
  },
  "firstTimeSubscriptionSubmission": {
    "status": "not_started",
    "requiresNewAppVersion": true,
    "manualWebsiteSelectionRequired": true,
    "selectedInAppStoreConnect": false,
    "selectedBuildId": "",
    "selectedProductIds": [],
    "notes": "For an app's first IAP or subscription, upload and select a processed build, then select the products with the app version in appstoreconnect.apple.com before submitting for review. Apple's public subscriptionSubmissions API can reject this first-time case with FIRST_SUBSCRIPTION_MUST_BE_SUBMITTED_ON_VERSION."
  },
  "onboarding": {
    "collectsPreferences": true,
    "paywallTiming": "afterFirstPersonalizedValue",
    "restorePurchasesVisible": true,
    "termsAndPrivacyVisibleOnPaywall": true,
    "defaultTrialPaywall": {
      "primaryCta": "Start 14-day free trial",
      "postCtaTagline": "\u2713 No payment due now",
      "showOnlyWhenStoreProductHasTrial": true,
      "continueFreePathVisible": true
    },
    "sportsEventAppPattern": [
      "Let users choose favorite teams, groups, or tournaments first.",
      "Show their personalized match/event hub before asking for purchase.",
      "Ask notification permission only after explaining fixture/reminder value.",
      "Present Pro as an upgrade for alerts, advanced tracking, widgets, or deeper historical views."
    ]
  },
  "reviewPromptPolicy": {
    "usesStoreKitRequestReview": true,
    "minimumDaysSinceInstall": 3,
    "minimumSessions": 3,
    "minimumPositiveActions": 2,
    "localCooldownDays": 120,
    "positiveMomentTriggers": [
      {
        "event": "followed_first_team_or_topic",
        "afterSuccessfulUserOutcome": true
      },
      {
        "event": "checked_personalized_match_center",
        "afterSuccessfulUserOutcome": true
      },
      {
        "event": "received_useful_match_alert",
        "afterSuccessfulUserOutcome": true
      }
    ],
    "blockedContexts": [
      "launch",
      "first_launch",
      "onboarding",
      "paywall",
      "purchase_flow",
      "subscription_cancel",
      "error",
      "offline",
      "permission_prompt"
    ]
  },
  "subscriptionReviewScreenshots": {
    "requiredBeforeSubmission": true,
    "allowSharedReviewScreenshot": false,
    "blackScreenCheckRequired": true,
    "planSpecificSelectionRequired": true,
    "expectedPlanSources": {
      "weekly": "screenshots/review/pro-paywall-weekly-selected.png",
      "monthly": "screenshots/review/pro-paywall-monthly-selected.png",
      "yearly": "screenshots/review/pro-paywall-yearly-selected.png"
    },
    "verificationCommand": "verify-subscription-review-screenshots --config appstore-submission.json --download-dir build/app-store/subscription-review-readback",
    "notes": "Before declaring the app ready, verify each subscription App Review screenshot is processed, visible, non-black, and plan-specific unless a shared screenshot is intentionally documented."
  }
}
